   <string notr="true">
QDialog {
    background-color: #f0f2f5;
}
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    margin-top: 8px;
    padding: 6px 8px 6px 8px;
    font-size: 13px;
    font-weight: bold;
    color: #333333;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #1a73e8;
}
QPushButton {
    background-color: #4a90d9;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #357abd;
}
QPushButton:pressed {
    background-color: #2a6099;
}
QPushButton#btn_emg_leftX,
QPushButton#btn_emg_leftY,
QPushButton#btn_emg_leftZ,
QPushButton#btn_emg_rightX,
QPushButton#btn_emg_rightY,
