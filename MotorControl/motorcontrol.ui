}
QPushButton#btn_emg_leftX:hover,
QPushButton#btn_emg_leftY:hover,
QPushButton#btn_emg_leftZ:hover,
QPushButton#btn_emg_rightX:hover,
QPushButton#btn_emg_rightY:hover,
